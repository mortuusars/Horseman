  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "contact": {
    "homepage": "${mod_page}",
    "sources": "${mod_github}"
  },
  "license": "${mod_license}",
  "icon": "icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "io.github.mortuusars.horseman.fabric.HorsemanFabric"
    ],
    "client": [
      "io.github.mortuusars.horseman.fabric.HorsemanFabricClient"
    ],
    "jei_mod_plugin": [
      "io.github.mortuusars.horseman.integration.jei.HorsemanJeiPlugin"
    ]
  },
  "mixins": [
    "horseman-common.mixins.json",
    "horseman-fabric.mixins.json"
  ],
  "depends": {
    "minecraft": ">=26.1",
    "fabric-api": "*",
    "fabricloader": ">=0.16.0",
    "forgeconfigapiport": ">=26.1"
